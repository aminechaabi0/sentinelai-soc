# REQUIRED: replace both values with long random secrets before use beyond localhost.
SENTINEL_API_KEY=replace-with-a-long-random-api-key
WAZUH_WEBHOOK_TOKEN=replace-with-a-different-long-random-webhook-token

# Optional: OpenAI-compatible chat completions API. Leave blank to disable AI.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# Optional: default is ./sentinel.db at project root.
SENTINEL_DB_PATH=./sentinel.db
